+// Only the background writer formats records. Non-finite native/app values
+// become JSON null so a damaged diagnostic remains machine-readable.
+struct Number(f64);
+impl fmt::Display for Number {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if self.0.is_finite() {
+            write!(f, "{:.9}", self.0)
+        } else {
+            f.write_str("null")
+        }
+    }
+}
+struct Optional(Option<u64>);
+impl fmt::Display for Optional {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.0 {
+            Some(n) => write!(f, "{n}"),
+            None => f.write_str("null"),
+        }
+    }
+}
+
+impl Record {
+    fn write(&self, output: &mut impl Write) -> io::Result<()> {
+        macro_rules! row {
+            ($kind:literal $(, $key:literal => $value:expr)* $(,)?) => {{
+                write!(output, "{{\"event\":\"{}\",\"seq\":{},\"at_s\":{}", $kind, self.seq, Number(self.at_s))?;
+                $(write!(output, ",\"{}\":{}", $key, $value)?;)*
+                writeln!(output, "}}")
+            }};
+        }
+        match self.event {
+            Event::NativeScroll {
+                window,
+                event_s,
+                dx,
+                dy,
+                phase,
+                momentum,
+                precise,
+            } => {
+                row!("native_scroll", "window"=>window, "event_uptime_s"=>Number(event_s), "dx"=>Number(dx), "dy"=>Number(dy), "phase"=>phase, "momentum"=>momentum, "precise"=>precise)
+            }
+            Event::ScenarioScroll { window, dx, dy } => {
+                row!("scenario_scroll", "window"=>window, "dx"=>Number(dx), "dy"=>Number(dy))
+            }
+            Event::MetalUpdate {
+                window,
+                drawable,
+                deadline_s,
+                target_s,
+                latency,
+                minimum,
+                maximum,
+                preferred,
+            } => {
+                row!("metal_update", "window"=>window, "drawable"=>drawable, "deadline_s"=>Number(deadline_s), "target_presentation_s"=>Number(target_s), "preferred_latency"=>Number(latency), "minimum_hz"=>Number(minimum), "maximum_hz"=>Number(maximum), "preferred_hz"=>Number(preferred))
+            }
+            Event::Wake { window } => row!("wake", "window"=>window),
+            Event::Decision {
+                window,
+                drawable,
+                used,
+                paused,
+            } => {
+                row!("frame_decision", "window"=>window, "drawable"=>drawable, "used_drawable"=>used, "paused"=>paused)
+            }
+            Event::HistoryOffset {
+                window,
+                top,
+                within,
+                row_height,
+                viewport,
+            } => {
+                row!("history_offset", "window"=>window, "top"=>top, "within"=>Number(within), "row_height"=>Number(row_height), "viewport"=>Number(viewport))
+            }
+            Event::SubmitBegin {
+                window,
+                drawable,
+                call,
+                revision,
+                new_scene,
+                marker,
+            } => {
+                row!("submit_begin", "window"=>window, "drawable"=>drawable, "call"=>call, "scene_revision"=>revision, "new_scene"=>new_scene, "history_marker"=>Optional(marker))
+            }
+            Event::SubmitEnd {
+                window,
+                drawable,
+                call,
+            } => row!("submit_end", "window"=>window, "drawable"=>drawable, "call"=>call),
+            Event::Presented {
+                window,
+                drawable,
+                call,
+                revision,
+                marker,
+                presented_s,
+            } => {
+                row!("presented", "window"=>window, "drawable"=>drawable, "call"=>call, "scene_revision"=>revision, "history_marker"=>Optional(marker), "presented_s"=>Number(presented_s), "did_present"=>(presented_s > 0.0))
+            }
+            Event::GpuCompleted {
+                window,
+                drawable,
+                call,
+                revision,
+                marker,
+                status,
+                gpu_start_s,
+                gpu_end_s,
+            } => {
+                row!("gpu_completed", "window"=>window, "drawable"=>drawable, "call"=>call, "scene_revision"=>revision, "history_marker"=>Optional(marker), "status"=>status, "gpu_start_s"=>Number(gpu_start_s), "gpu_end_s"=>Number(gpu_end_s))
+            }
+        }
+    }
+}
