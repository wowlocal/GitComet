+pub(crate) struct Submission {
+    capture: Arc<Capture>,
+    window: u64,
+    drawable: u64,
+    call: u64,
+    revision: u64,
+    marker: Option<u64>,
+}
+
+impl Submission {
+    pub fn presented(&self, presented_s: f64) {
