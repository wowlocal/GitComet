index 0000000000..2b2248aef5
--- /dev/null
+++ b/crates/gpui_apple/src/native_timing.rs
@@ -0,0 +1,1130 @@
+//! Private, opt-in, bounded native scrolling/presentation diagnostics.
+//!
+//! Set `GPUI_NATIVE_TIMING_PATH` to a local JSONL destination. Capture normally
+//! starts at the first native precise touch/momentum packet, then ends after
+//! `GPUI_NATIVE_TIMING_SECONDS` (30 by default, at most 120). `GPUI_NATIVE_TIMING_ARM`
+//! may be `immediate` for a programmatic replay. Only numeric scrolling and
+//! presentation metadata are retained.
+//! The disabled path does not read clocks, allocate, create threads or write files.
+
+use objc2_foundation::NSProcessInfo;
+use objc2_quartz_core::CACurrentMediaTime;
+use std::{
+    fmt,
+    fs::{self, OpenOptions},
+    io::{self, BufWriter, Write},
+    path::PathBuf,
+    sync::{
+        Arc, Condvar, Mutex, OnceLock,
+        atomic::{AtomicU8, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+const WAITING: u8 = 0;
+const RECORDING: u8 = 1;
+const FINISHED: u8 = 2;
+const MAX_RECORDS: usize = 32_768;
+const MAX_MARKERS: usize = 16;
+static CAPTURE: OnceLock<Option<Arc<Capture>>> = OnceLock::new();
+
+struct Config {
+    path: PathBuf,
+    duration: Duration,
+    immediate: bool,
+    link_options: LinkOptions,
+}
+
+/// Normal launches retain the system frame policy. Private capture selectors
+/// compare explicit policies in the same binary. Rates come from NSScreen.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(crate) struct LinkOptions {
+    display_maximum: bool,
+    pub latency: Option<f32>,
+}
+
+impl LinkOptions {
+    fn for_launch(capture_options: Option<Self>) -> Self {
+        capture_options.unwrap_or_default()
+    }
+
+    fn parse(frame_rate: Option<&str>, latency: Option<&str>) -> Option<Self> {
+        let display_maximum = match frame_rate {
+            None | Some("default") => false,
+            Some("display-max") => true,
+            _ => return None,
+        };
+        let latency = match latency {
+            None => None,
+            Some("1") => Some(1.0),
+            Some("2") => Some(2.0),
+            _ => return None,
+        };
+        Some(Self {
+            display_maximum,
+            latency,
+        })
+    }
+
+    pub fn maximum_rate(self, screen_maximum: Option<f32>) -> Option<f32> {
+        screen_maximum
+            .filter(|maximum| self.display_maximum && maximum.is_finite() && *maximum > 0.0)
+    }
+
+    fn mode(self) -> &'static str {
+        if self.display_maximum {
+            "display-max"
+        } else {
+            "default"
+        }
+    }
+}
+
+pub(crate) fn link_options() -> LinkOptions {
+    LinkOptions::for_launch(capture().map(|c| c.config.link_options))
+}
