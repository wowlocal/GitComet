+        let capture = Arc::new(Capture {
+            config: Config {
+                path: path.clone(),
+                duration: Duration::from_millis(20),
+                immediate: false,
+                link_options: LinkOptions::default(),
+            },
+            phase: AtomicU8::new(WAITING),
+            buffer: Mutex::new(Buffer::new(2)),
+            changed: Condvar::new(),
+        });
+        let worker = capture.clone();
+        let (finished, completion) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            worker.run();
+            let _ = finished.send(());
+        });
+        std::thread::sleep(Duration::from_millis(35));
+        assert_eq!(capture.phase.load(Ordering::Acquire), WAITING);
