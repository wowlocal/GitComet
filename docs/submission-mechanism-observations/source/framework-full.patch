+    #[test]
+    fn private_link_overrides_accept_only_the_named_modes_and_supported_latencies() {
+        assert_eq!(LinkOptions::parse(None, None), Some(LinkOptions::default()));
+        let maximum = LinkOptions::parse(Some("display-max"), Some("1")).unwrap();
+        assert!(maximum.display_maximum);
+        assert_eq!(maximum.latency, Some(1.0));
+        assert_eq!(
+            LinkOptions::parse(Some("default"), Some("2"))
+                .unwrap()
