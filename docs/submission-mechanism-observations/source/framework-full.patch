+pub(crate) fn submission(
+    window: u64,
+    drawable: u64,
+    call: u64,
+    revision: u64,
+    new_scene: bool,
+) -> Option<Arc<Submission>> {
+    let capture = active()?;
+    let at_s = CACurrentMediaTime();
+    let mut buffer = capture.buffer.lock().unwrap_or_else(|e| e.into_inner());
+    let marker = buffer.marker(window);
+    let seq = buffer.push(
+        at_s,
+        Event::SubmitBegin {
+            window,
+            drawable,
+            call,
+            revision,
+            new_scene,
+            marker,
+        },
+    );
+    if buffer.stop.is_some() {
+        capture.changed.notify_one();
+    }
+    seq?;
+    Some(Arc::new(Submission {
+        capture: capture.clone(),
+        window,
+        drawable,
+        call,
+        revision,
+        marker,
+    }))
+}
