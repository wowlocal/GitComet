+    #[test]
+    fn completion_metadata_can_outlive_its_owner_without_retaining_native_buffers() {
+        let clock = ClockAnchor::now();
+        let mut buffer = Buffer::new(2);
+        buffer.arm = Some(Arm {
+            clock,
+            deadline: Instant::now() + Duration::from_secs(1),
+            until_s: clock.ca_s + 1.0,
+        });
+        let capture = Arc::new(Capture {
+            config: Config {
+                path: PathBuf::new(),
+                duration: Duration::from_secs(1),
+                immediate: false,
+                link_options: LinkOptions::default(),
+            },
+            phase: AtomicU8::new(RECORDING),
+            buffer: Mutex::new(buffer),
+            changed: Condvar::new(),
+        });
+        let submission = Arc::new(Submission {
+            capture: capture.clone(),
+            window: 1,
+            drawable: 2,
+            call: 3,
+            revision: 4,
+            marker: Some(5),
+        });
+        let weak = Arc::downgrade(&submission);
+        std::thread::spawn(move || submission.gpu_completed(4, 1.25, 1.5))
+            .join()
+            .unwrap();
+        assert!(weak.upgrade().is_none());
+        assert_eq!(Arc::strong_count(&capture), 1);
+        let buffer = capture.buffer.lock().unwrap();
+        assert_eq!(buffer.records.len(), 1);
+        match buffer.records[0].event {
+            Event::GpuCompleted {
+                window,
+                drawable,
+                call,
+                revision,
+                marker,
+                status,
+                gpu_start_s,
+                gpu_end_s,
+            } => {
+                assert_eq!(
+                    (window, drawable, call, revision, marker, status),
+                    (1, 2, 3, 4, Some(5), 4)
+                );
+                assert_eq!((gpu_start_s, gpu_end_s), (1.25, 1.5));
+            }
+            _ => panic!("completion must retain its submission identity"),
+        }
+    }
