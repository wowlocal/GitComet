+    #[test]
+    fn overflow_stops_without_growing_or_overwriting_earlier_records() {
+        let mut buffer = armed(2);
+        assert_eq!(buffer.push(1.0, Event::Wake { window: 1 }), Some(1));
+        assert_eq!(buffer.push(2.0, Event::Wake { window: 1 }), Some(2));
+        assert_eq!(buffer.push(3.0, Event::Wake { window: 1 }), None);
+        assert!(matches!(buffer.stop, Some(Stop::Capacity)));
+        assert_eq!(buffer.records.len(), 2);
+        assert_eq!(buffer.records[0].at_s, 1.0);
+        assert_eq!(buffer.dropped, 1);
+    }
+
+    #[test]
+    fn clock_anchor_maps_event_uptime_into_the_native_clock() {
+        let anchor = ClockAnchor {
+            ca_s: 10.0,
+            uptime_s: 9.75,
+        };
+        assert_eq!(anchor.event_to_ca(9.0), 9.25);
+    }
+
+    #[test]
+    fn latest_marker_is_window_scoped_and_does_not_allocate_more_slots() {
+        let mut buffer = armed(2);
+        buffer.set_marker(1, 7);
+        buffer.set_marker(2, 8);
+        buffer.set_marker(1, 9);
+        assert_eq!(buffer.marker(1), Some(9));
+        assert_eq!(buffer.marker(2), Some(8));
+        for window in 3..=MAX_MARKERS as u64 {
+            buffer.set_marker(window, window);
+        }
+        buffer.set_marker(100, 20);
+        assert_eq!(buffer.marker_overflow, 1);
+        assert_eq!(buffer.marker(100), None);
+    }
+
+    #[test]
+    fn lifecycle_zero_deltas_and_nonfinite_values_serialize_as_valid_tokens() {
+        let record = Record {
+            seq: 1,
+            at_s: 2.0,
+            event: Event::NativeScroll {
+                window: 3,
+                event_s: 1.5,
+                dx: 0.0,
+                dy: f64::NAN,
+                phase: 8,
+                momentum: 1,
+                precise: true,
+            },
+        };
+        let mut output = Vec::new();
+        record.write(&mut output).unwrap();
+        let output = String::from_utf8(output).unwrap();
+        assert!(output.contains("\"dx\":0.000000000"));
+        assert!(output.contains("\"dy\":null"));
+        assert!(output.contains("\"phase\":8,\"momentum\":1,\"precise\":true"));
+    }
+}
