+    #[test]
+    fn normal_launch_preserves_system_defaults_and_capture_can_override_them() {
+        let normal = LinkOptions::for_launch(None);
+        assert_eq!(normal.maximum_rate(Some(120.0)), None);
+        assert_eq!(normal.latency, None);
+        let baseline = LinkOptions::for_launch(Some(LinkOptions::default()));
+        assert_eq!(baseline.maximum_rate(Some(120.0)), None);
+        assert_eq!(baseline.latency, None);
+    }
