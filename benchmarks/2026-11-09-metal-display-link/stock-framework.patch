+
+    #[test]
+    fn worker_waits_to_arm_then_flushes_automatically_with_clock_metadata() {
+        let path = std::env::temp_dir().join(format!(
+            "gpui-native-timing-{}-{}.jsonl",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        let capture = Arc::new(Capture {
+            config: Config {
+                path: path.clone(),
+                duration: Duration::from_millis(20),
+                immediate: false,
+                link_options: LinkOptions::default(),
+            },
+            phase: AtomicU8::new(WAITING),
+            buffer: Mutex::new(Buffer::new(2)),
+            changed: Condvar::new(),
+        });
+        let worker = capture.clone();
+        let (finished, completion) = std::sync::mpsc::channel();
+        std::thread::spawn(move || {
+            worker.run();
+            let _ = finished.send(());
+        });
+        std::thread::sleep(Duration::from_millis(35));
+        assert_eq!(capture.phase.load(Ordering::Acquire), WAITING);
+        capture.arm();
+        completion.recv_timeout(Duration::from_secs(2)).unwrap();
+        let output = fs::read_to_string(&path).unwrap();
+        fs::remove_file(path).unwrap();
+        assert!(output.contains("waiting_for_native_precise_scroll"));
+        assert!(output.contains("\"event\":\"capture_armed\""));
+        assert!(output.contains("\"event_to_ca_offset_s\":"));
+        assert!(output.contains("\"reason\":\"duration\",\"records\":0,\"dropped\":0"));
+        assert_eq!(capture.phase.load(Ordering::Acquire), FINISHED);
+    }
+
+    #[test]
+    fn an_existing_destination_is_preserved() {
+        let path = std::env::temp_dir().join(format!(
+            "gpui-native-timing-existing-{}-{}.jsonl",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::write(&path, b"previous capture").unwrap();
+        let capture = Capture {
+            config: Config {
+                path: path.clone(),
+                duration: Duration::from_secs(1),
+                immediate: false,
+                link_options: LinkOptions::default(),
+            },
+            phase: AtomicU8::new(WAITING),
+            buffer: Mutex::new(Buffer::new(2)),
+            changed: Condvar::new(),
+        };
+        assert_eq!(
+            capture.header().unwrap_err().kind(),
+            io::ErrorKind::AlreadyExists
+        );
+        assert_eq!(fs::read(&path).unwrap(), b"previous capture");
+        fs::remove_file(path).unwrap();
+    }
