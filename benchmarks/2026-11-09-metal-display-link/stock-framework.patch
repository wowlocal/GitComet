@@ -0,0 +1,1082 @@
+//! Private, opt-in, bounded native scrolling/presentation diagnostics.
+//!
+//! Set `GPUI_NATIVE_TIMING_PATH` to a local JSONL destination. Capture normally
+//! starts at the first native precise touch/momentum packet, then ends after
+//! `GPUI_NATIVE_TIMING_SECONDS` (30 by default, at most 120). `GPUI_NATIVE_TIMING_ARM`
+//! may be `immediate` for a programmatic replay. Only numeric scrolling and
+//! presentation metadata are retained.
+//! The disabled path does not read clocks, allocate, create threads or write files.
+
+use objc2_foundation::NSProcessInfo;
+use objc2_quartz_core::CACurrentMediaTime;
+use std::{
+    fmt,
+    fs::{self, OpenOptions},
+    io::{self, BufWriter, Write},
+    path::PathBuf,
+    sync::{
+        Arc, Condvar, Mutex, OnceLock,
+        atomic::{AtomicU8, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+const WAITING: u8 = 0;
+const RECORDING: u8 = 1;
+const FINISHED: u8 = 2;
+const MAX_RECORDS: usize = 32_768;
+const MAX_MARKERS: usize = 16;
+static CAPTURE: OnceLock<Option<Arc<Capture>>> = OnceLock::new();
+
+struct Config {
+    path: PathBuf,
+    duration: Duration,
+    immediate: bool,
+    link_options: LinkOptions,
+}
+
+/// Normal launches retain the system frame policy. Private capture selectors
+/// compare explicit policies in the same binary. Rates come from NSScreen.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub(crate) struct LinkOptions {
+    display_maximum: bool,
+    pub latency: Option<f32>,
+}
+
+impl LinkOptions {
+    fn for_launch(capture_options: Option<Self>) -> Self {
+        capture_options.unwrap_or_default()
+    }
+
+    fn parse(frame_rate: Option<&str>, latency: Option<&str>) -> Option<Self> {
+        let display_maximum = match frame_rate {
+            None | Some("default") => false,
+            Some("display-max") => true,
+            _ => return None,
+        };
+        let latency = match latency {
+            None => None,
+            Some("1") => Some(1.0),
+            Some("2") => Some(2.0),
+            _ => return None,
+        };
+        Some(Self {
+            display_maximum,
+            latency,
+        })
+    }
+
+    pub fn maximum_rate(self, screen_maximum: Option<f32>) -> Option<f32> {
+        screen_maximum
+            .filter(|maximum| self.display_maximum && maximum.is_finite() && *maximum > 0.0)
+    }
+
+    fn mode(self) -> &'static str {
+        if self.display_maximum {
+            "display-max"
+        } else {
+            "default"
+        }
+    }
+}
+
+pub(crate) fn link_options() -> LinkOptions {
+    LinkOptions::for_launch(capture().map(|c| c.config.link_options))
+}
+
+/// Whether the selected policy needs the current Metal window's screen rate.
+#[doc(hidden)]
+pub fn requests_display_maximum() -> bool {
+    link_options().display_maximum
+}
+
+#[derive(Clone, Copy)]
+struct ClockAnchor {
+    ca_s: f64,
+    uptime_s: f64,
+}
+
+impl ClockAnchor {
+    fn now() -> Self {
+        Self {
+            ca_s: CACurrentMediaTime(),
+            uptime_s: NSProcessInfo::processInfo().systemUptime(),
+        }
+    }
+
+    fn event_to_ca(self, event_s: f64) -> f64 {
+        event_s + self.ca_s - self.uptime_s
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Arm {
+    clock: ClockAnchor,
+    deadline: Instant,
+    until_s: f64,
+}
+
+#[derive(Clone, Copy)]
+struct Marker {
+    window: u64,
+    seq: u64,
+}
+
+#[derive(Clone, Copy)]
+enum Event {
+    NativeScroll {
+        window: u64,
+        event_s: f64,
+        dx: f64,
+        dy: f64,
+        phase: u64,
+        momentum: u64,
+        precise: bool,
+    },
+    ScenarioScroll {
+        window: u64,
+        dx: f64,
+        dy: f64,
+    },
+    MetalUpdate {
+        window: u64,
+        drawable: u64,
+        deadline_s: f64,
+        target_s: f64,
+        latency: f64,
+        minimum: f64,
+        maximum: f64,
+        preferred: f64,
+    },
+    Wake {
+        window: u64,
+    },
+    Decision {
+        window: u64,
+        used: bool,
+        paused: bool,
+    },
+    HistoryOffset {
+        window: u64,
+        top: u64,
+        within: f64,
+        row_height: f64,
+        viewport: f64,
+    },
+    SubmitBegin {
+        window: u64,
+        drawable: u64,
+        call: u64,
+        revision: u64,
+        new_scene: bool,
+        marker: Option<u64>,
+    },
+    SubmitEnd {
+        window: u64,
+        drawable: u64,
+        call: u64,
+    },
+    Presented {
+        window: u64,
+        drawable: u64,
+        call: u64,
+        revision: u64,
+        marker: Option<u64>,
+        presented_s: f64,
+    },
+    GpuCompleted {
+        window: u64,
+        drawable: u64,
+        call: u64,
+        revision: u64,
+        marker: Option<u64>,
+        status: u64,
+        gpu_start_s: f64,
+        gpu_end_s: f64,
+    },
+}
+
+struct Record {
+    seq: u64,
+    at_s: f64,
+    event: Event,
+}
+
+#[derive(Clone, Copy)]
+enum Stop {
+    Duration,
+    Capacity,
+}
+
+struct Buffer {
+    arm: Option<Arm>,
+    stop: Option<Stop>,
+    records: Vec<Record>,
+    capacity: usize,
+    next_seq: u64,
+    dropped: u64,
+    marker_overflow: u64,
+    markers: [Option<Marker>; MAX_MARKERS],
+}
+
+impl Buffer {
+    fn new(capacity: usize) -> Self {
+        Self {
+            arm: None,
+            stop: None,
+            records: Vec::with_capacity(capacity),
+            capacity,
+            next_seq: 1,
+            dropped: 0,
+            marker_overflow: 0,
+            markers: [None; MAX_MARKERS],
+        }
+    }
+
+    fn push(&mut self, at_s: f64, event: Event) -> Option<u64> {
+        if self.arm.is_none() || self.stop.is_some() {
+            return None;
+        }
+        if at_s >= self.arm.unwrap().until_s {
+            self.stop = Some(Stop::Duration);
+            return None;
+        }
+        if self.records.len() == self.capacity {
+            self.dropped += 1;
+            self.stop = Some(Stop::Capacity);
+            return None;
+        }
+        let seq = self.next_seq;
+        self.next_seq += 1;
+        self.records.push(Record { seq, at_s, event });
+        Some(seq)
+    }
+
+    fn marker(&self, window: u64) -> Option<u64> {
+        self.markers
+            .iter()
+            .flatten()
+            .find(|m| m.window == window)
+            .map(|m| m.seq)
+    }
+
+    fn set_marker(&mut self, window: u64, seq: u64) {
+        if let Some(slot) = self
+            .markers
+            .iter_mut()
+            .find(|m| m.is_some_and(|m| m.window == window))
+        {
+            *slot = Some(Marker { window, seq });
+        } else if let Some(slot) = self.markers.iter_mut().find(|m| m.is_none()) {
+            *slot = Some(Marker { window, seq });
+        } else {
+            self.marker_overflow += 1;
+        }
+    }
+}
+
+struct Capture {
+    config: Config,
+    phase: AtomicU8,
+    buffer: Mutex<Buffer>,
+    changed: Condvar,
+}
+
+fn capture() -> Option<&'static Arc<Capture>> {
+    CAPTURE
+        .get_or_init(|| {
+            let path = PathBuf::from(std::env::var_os("GPUI_NATIVE_TIMING_PATH")?);
+            if path.as_os_str().is_empty() {
+                return None;
+            }
+            let seconds = std::env::var("GPUI_NATIVE_TIMING_SECONDS")
+                .ok()
+                .and_then(|s| s.parse::<u64>().ok())
+                .unwrap_or(30)
+                .clamp(1, 120);
+            let immediate = std::env::var("GPUI_NATIVE_TIMING_ARM").is_ok_and(|s| s == "immediate");
+            let frame_rate = std::env::var("GPUI_NATIVE_TIMING_FRAME_RATE").ok();
+            let latency = std::env::var("GPUI_NATIVE_TIMING_LATENCY").ok();
+            let link_options = LinkOptions::parse(frame_rate.as_deref(), latency.as_deref())
+                .unwrap_or_else(|| {
+                    log::warn!(
+                        "invalid native timing A/B selector; frame-rate/latency overrides disabled"
+                    );
+                    LinkOptions::default()
+                });
+            let capture = Arc::new(Capture {
+                config: Config {
+                    path,
+                    duration: Duration::from_secs(seconds),
+                    immediate,
+                    link_options,
+                },
+                phase: AtomicU8::new(WAITING),
+                buffer: Mutex::new(Buffer::new(MAX_RECORDS)),
+                changed: Condvar::new(),
+            });
+            if immediate {
+                capture.arm();
+            }
+            let worker = capture.clone();
+            if let Err(error) = std::thread::Builder::new()
+                .name("gpui-native-timing".into())
+                .spawn(move || worker.run())
+            {
+                log::error!("native timing worker could not start: {error}");
+                return None;
+            }
+            Some(capture)
+        })
+        .as_ref()
+}
+
+/// True only when configured and not finished. Does no clock work when disabled.
+pub fn enabled() -> bool {
+    capture().is_some_and(|c| c.phase.load(Ordering::Acquire) != FINISHED)
+}
+
+fn active() -> Option<&'static Arc<Capture>> {
+    capture().filter(|c| c.phase.load(Ordering::Acquire) == RECORDING)
+}
+
+impl Capture {
+    fn arm(&self) {
+        let mut buffer = self.buffer.lock().unwrap_or_else(|e| e.into_inner());
+        if buffer.arm.is_none() && self.phase.load(Ordering::Acquire) == WAITING {
+            let clock = ClockAnchor::now();
+            buffer.arm = Some(Arm {
+                clock,
+                deadline: Instant::now() + self.config.duration,
+                until_s: clock.ca_s + self.config.duration.as_secs_f64(),
+            });
+            self.phase.store(RECORDING, Ordering::Release);
+            self.changed.notify_one();
+        }
+    }
+
+    fn record(&self, event: Event) -> Option<u64> {
+        if self.phase.load(Ordering::Acquire) != RECORDING {
+            return None;
+        }
+        let at_s = CACurrentMediaTime();
+        let mut buffer = self.buffer.lock().unwrap_or_else(|e| e.into_inner());
+        let seq = buffer.push(at_s, event);
+        if buffer.stop.is_some() {
+            self.changed.notify_one();
+        }
+        seq
+    }
+
+    fn run(&self) {
+        // This initial status makes an unarmed capture explicit. The worker is
+        // allowed to wait indefinitely while a person reads the instructions.
+        if let Err(error) = self.header() {
+            // Serialize with arm(): a first packet racing this failure must
+            // never revive a recorder whose only worker has already exited.
+            {
+                let _buffer = self.buffer.lock().unwrap_or_else(|e| e.into_inner());
+                self.phase.store(FINISHED, Ordering::Release);
+            }
+            log::error!("native timing output could not be created: {error}");
+            return;
+        }
+        let mut buffer = self.buffer.lock().unwrap_or_else(|e| e.into_inner());
+        while buffer.arm.is_none() {
+            buffer = self.changed.wait(buffer).unwrap_or_else(|e| e.into_inner());
+        }
+        let arm = buffer.arm.unwrap();
+        while buffer.stop.is_none() {
+            let remaining = arm.deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                buffer.stop = Some(Stop::Duration);
+                break;
+            }
+            (buffer, _) = self
+                .changed
+                .wait_timeout(buffer, remaining)
+                .unwrap_or_else(|e| e.into_inner());
+        }
+        self.phase.store(FINISHED, Ordering::Release);
+        let stop = buffer.stop.unwrap();
+        let records = std::mem::take(&mut buffer.records);
+        let dropped = buffer.dropped;
+        let marker_overflow = buffer.marker_overflow;
+        drop(buffer);
+        if let Err(error) = self.flush(arm, stop, &records, dropped, marker_overflow) {
+            log::error!("native timing output could not be flushed: {error}");
+        }
+    }
+
+    fn header(&self) -> io::Result<()> {
+        if let Some(parent) = self
+            .config
+            .path
+            .parent()
+            .filter(|p| !p.as_os_str().is_empty())
+        {
+            fs::create_dir_all(parent)?;
+        }
+        let mut output = BufWriter::new(
+            OpenOptions::new()
+                .create_new(true)
+                .write(true)
+                .open(&self.config.path)?,
+        );
+        writeln!(
+            output,
+            "{{\"event\":\"capture_status\",\"version\":2,\"status\":\"{}\",\"pid\":{},\"duration_s\":{},\"max_records\":{},\"max_marker_windows\":{},\"record_size_bytes\":{},\"clock\":\"CACurrentMediaTime_seconds\",\"native_event_clock\":\"system_uptime_seconds\",\"native_origin\":\"AppKit_packets_not_verified_hardware\",\"requested_frame_rate_mode\":\"{}\",\"requested_latency\":{}}}",
+            if self.config.immediate {
+                "immediate_arm"
+            } else {
+                "waiting_for_native_precise_scroll"
+            },
+            std::process::id(),
+            self.config.duration.as_secs(),
+            MAX_RECORDS,
+            MAX_MARKERS,
+            std::mem::size_of::<Record>(),
+            self.config.link_options.mode(),
+            Optional(
+                self.config
+                    .link_options
+                    .latency
+                    .map(|latency| latency as u64)
+            )
+        )?;
+        output.flush()
+    }
+
+    fn flush(
+        &self,
+        arm: Arm,
+        stop: Stop,
+        records: &[Record],
+        dropped: u64,
+        marker_overflow: u64,
+    ) -> io::Result<()> {
+        let mut output = BufWriter::new(OpenOptions::new().append(true).open(&self.config.path)?);
+        writeln!(
+            output,
+            "{{\"event\":\"capture_armed\",\"ca_anchor_s\":{},\"uptime_anchor_s\":{},\"event_to_ca_offset_s\":{}}}",
+            Number(arm.clock.ca_s),
+            Number(arm.clock.uptime_s),
+            Number(arm.clock.event_to_ca(0.0))
+        )?;
+        for record in records {
+            record.write(&mut output)?;
+        }
+        writeln!(
+            output,
+            "{{\"event\":\"capture_status\",\"status\":\"complete\",\"reason\":\"{}\",\"records\":{},\"dropped\":{},\"marker_overflow\":{},\"flushed_at_s\":{}}}",
+            match stop {
+                Stop::Duration => "duration",
+                Stop::Capacity => "capacity",
+            },
+            records.len(),
+            dropped,
+            marker_overflow,
+            Number(CACurrentMediaTime())
+        )?;
+        output.flush()
+    }
+}
+
+/// Record a native AppKit packet, including zero-delta lifecycle packets.
+#[doc(hidden)]
+pub fn native_scroll(
+    window: u64,
+    event_s: f64,
+    dx: f64,
+    dy: f64,
+    phase: u64,
+    momentum: u64,
+    precise: bool,
+) {
+    if let Some(capture) = capture() {
+        if capture.phase.load(Ordering::Acquire) == WAITING && native_arms(precise, phase, momentum)
+        {
+            capture.arm();
+        }
+        capture.record(Event::NativeScroll {
+            window,
+            event_s,
+            dx,
+            dy,
+            phase,
+            momentum,
+            precise,
+        });
+    }
+}
+
+fn native_arms(precise: bool, phase: u64, momentum: u64) -> bool {
+    precise && (phase != 0 || momentum != 0)
+}
+
+/// Optional experiment marker for a scenario packet dispatched without AppKit.
+/// It never arms a capture that is waiting for a native packet.
+pub fn scenario_scroll(window: u64, dx: f64, dy: f64) {
+    if let Some(capture) = active() {
+        capture.record(Event::ScenarioScroll { window, dx, dy });
+    }
+}
+
+/// Mark the actual indexed-history geometry during prepaint. The next renderer
+/// submission links this record by sequence; repeated cached scenes keep it.
+pub fn history_offset(window: u64, top: u64, within: f64, row_height: f64, viewport: f64) {
+    if let Some(capture) = active() {
+        let at_s = CACurrentMediaTime();
+        let mut buffer = capture.buffer.lock().unwrap_or_else(|e| e.into_inner());
+        if let Some(seq) = buffer.push(
+            at_s,
+            Event::HistoryOffset {
+                window,
+                top,
+                within,
+                row_height,
+                viewport,
+            },
+        ) {
+            buffer.set_marker(window, seq);
+        }
+        if buffer.stop.is_some() {
+            capture.changed.notify_one();
+        }
+    }
+}
+
+pub(crate) fn metal_update(
+    window: u64,
+    drawable: u64,
+    deadline_s: f64,
+    target_s: f64,
+    latency: f64,
+    range: [f64; 3],
+) {
+    if let Some(capture) = active() {
+        capture.record(Event::MetalUpdate {
+            window,
+            drawable,
+            deadline_s,
+            target_s,
+            latency,
+            minimum: range[0],
+            maximum: range[1],
+            preferred: range[2],
+        });
+    }
+}
+
+#[doc(hidden)]
+pub fn wake(window: u64) {
+    if let Some(capture) = active() {
+        capture.record(Event::Wake { window });
+    }
+}
+
+#[doc(hidden)]
+pub fn decision(window: u64, used: bool, paused: bool) {
+    if let Some(capture) = active() {
+        capture.record(Event::Decision {
+            window,
+            used,
+            paused,
+        });
+    }
+}
+
+pub(crate) struct Submission {
+    capture: Arc<Capture>,
+    window: u64,
+    drawable: u64,
+    call: u64,
+    revision: u64,
+    marker: Option<u64>,
+}
+
+impl Submission {
+    pub fn presented(&self, presented_s: f64) {
+        self.capture.record(Event::Presented {
+            window: self.window,
+            drawable: self.drawable,
+            call: self.call,
+            revision: self.revision,
+            marker: self.marker,
+            presented_s,
+        });
+    }
+
+    pub fn end(&self) {
+        self.capture.record(Event::SubmitEnd {
+            window: self.window,
+            drawable: self.drawable,
+            call: self.call,
+        });
+    }
+
+    pub fn gpu_completed(&self, status: u64, gpu_start_s: f64, gpu_end_s: f64) {
+        self.capture.record(Event::GpuCompleted {
+            window: self.window,
+            drawable: self.drawable,
+            call: self.call,
+            revision: self.revision,
+            marker: self.marker,
+            status,
+            gpu_start_s,
+            gpu_end_s,
+        });
+    }
+}
+
+pub(crate) fn submission(
+    window: u64,
+    drawable: u64,
+    call: u64,
+    revision: u64,
+    new_scene: bool,
+) -> Option<Arc<Submission>> {
+    let capture = active()?;
+    let at_s = CACurrentMediaTime();
+    let mut buffer = capture.buffer.lock().unwrap_or_else(|e| e.into_inner());
+    let marker = buffer.marker(window);
+    let seq = buffer.push(
+        at_s,
+        Event::SubmitBegin {
+            window,
+            drawable,
+            call,
+            revision,
+            new_scene,
+            marker,
+        },
+    );
+    if buffer.stop.is_some() {
+        capture.changed.notify_one();
+    }
+    seq?;
+    Some(Arc::new(Submission {
+        capture: capture.clone(),
+        window,
+        drawable,
+        call,
+        revision,
+        marker,
+    }))
+}
+
+// Only the background writer formats records. Non-finite native/app values
+// become JSON null so a damaged diagnostic remains machine-readable.
+struct Number(f64);
+impl fmt::Display for Number {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        if self.0.is_finite() {
+            write!(f, "{:.9}", self.0)
+        } else {
+            f.write_str("null")
+        }
+    }
+}
+struct Optional(Option<u64>);
+impl fmt::Display for Optional {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.0 {
+            Some(n) => write!(f, "{n}"),
+            None => f.write_str("null"),
+        }
+    }
+}
+
+impl Record {
+    fn write(&self, output: &mut impl Write) -> io::Result<()> {
+        macro_rules! row {
+            ($kind:literal $(, $key:literal => $value:expr)* $(,)?) => {{
+                write!(output, "{{\"event\":\"{}\",\"seq\":{},\"at_s\":{}", $kind, self.seq, Number(self.at_s))?;
+                $(write!(output, ",\"{}\":{}", $key, $value)?;)*
+                writeln!(output, "}}")
+            }};
+        }
+        match self.event {
+            Event::NativeScroll {
+                window,
+                event_s,
+                dx,
+                dy,
+                phase,
+                momentum,
+                precise,
+            } => {
+                row!("native_scroll", "window"=>window, "event_uptime_s"=>Number(event_s), "dx"=>Number(dx), "dy"=>Number(dy), "phase"=>phase, "momentum"=>momentum, "precise"=>precise)
+            }
+            Event::ScenarioScroll { window, dx, dy } => {
+                row!("scenario_scroll", "window"=>window, "dx"=>Number(dx), "dy"=>Number(dy))
+            }
+            Event::MetalUpdate {
+                window,
+                drawable,
+                deadline_s,
+                target_s,
+                latency,
+                minimum,
+                maximum,
+                preferred,
+            } => {
+                row!("metal_update", "window"=>window, "drawable"=>drawable, "deadline_s"=>Number(deadline_s), "target_presentation_s"=>Number(target_s), "preferred_latency"=>Number(latency), "minimum_hz"=>Number(minimum), "maximum_hz"=>Number(maximum), "preferred_hz"=>Number(preferred))
+            }
+            Event::Wake { window } => row!("wake", "window"=>window),
+            Event::Decision {
+                window,
+                used,
+                paused,
+            } => row!("frame_decision", "window"=>window, "used_drawable"=>used, "paused"=>paused),
+            Event::HistoryOffset {
+                window,
+                top,
+                within,
+                row_height,
+                viewport,
+            } => {
+                row!("history_offset", "window"=>window, "top"=>top, "within"=>Number(within), "row_height"=>Number(row_height), "viewport"=>Number(viewport))
+            }
+            Event::SubmitBegin {
+                window,
+                drawable,
+                call,
+                revision,
+                new_scene,
+                marker,
+            } => {
+                row!("submit_begin", "window"=>window, "drawable"=>drawable, "call"=>call, "scene_revision"=>revision, "new_scene"=>new_scene, "history_marker"=>Optional(marker))
+            }
+            Event::SubmitEnd {
+                window,
+                drawable,
+                call,
+            } => row!("submit_end", "window"=>window, "drawable"=>drawable, "call"=>call),
+            Event::Presented {
+                window,
+                drawable,
+                call,
+                revision,
+                marker,
+                presented_s,
+            } => {
+                row!("presented", "window"=>window, "drawable"=>drawable, "call"=>call, "scene_revision"=>revision, "history_marker"=>Optional(marker), "presented_s"=>Number(presented_s), "did_present"=>(presented_s > 0.0))
+            }
+            Event::GpuCompleted {
+                window,
+                drawable,
+                call,
+                revision,
+                marker,
+                status,
+                gpu_start_s,
+                gpu_end_s,
+            } => {
+                row!("gpu_completed", "window"=>window, "drawable"=>drawable, "call"=>call, "scene_revision"=>revision, "history_marker"=>Optional(marker), "status"=>status, "gpu_start_s"=>Number(gpu_start_s), "gpu_end_s"=>Number(gpu_end_s))
+            }
+        }
+    }
+}
