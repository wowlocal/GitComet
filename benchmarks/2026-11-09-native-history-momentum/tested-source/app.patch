+    let before = counters(&bar, cx);
+    state.repos[1].spec.workdir = "/tmp/tab-cache/a-renamed-repository".into();
+    state.repos[1].incoming = RepoIncomingState::Current(RepoIncomingSnapshot {
+        tracking: HeadTracking::Tracking {
+            branch: "main".into(),
+            upstream: Upstream {
+                remote: "origin".into(),
+                branch: "main".into(),
+            },
