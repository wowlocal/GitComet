+fn momentum_packet(
+    cx: &mut VisualTestContext,
+    delta: f32,
+    source: ReplaySource,
+    phase: TouchPhase,
+    ended: bool,
+) {
+    momentum_packet_with_age(cx, delta, source, phase, ended, std::time::Duration::ZERO);
