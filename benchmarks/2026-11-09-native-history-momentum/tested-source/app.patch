+            let bar = bar.read(app);
+            let reopened = &bar.presentation.tabs[TAB_COUNT - 1].slide;
+            assert!(!std::rc::Weak::ptr_eq(&closed, &Rc::downgrade(reopened)));
+            assert_eq!(reopened.borrow().as_ref().unwrap().from_offset_x, px(0.0));
