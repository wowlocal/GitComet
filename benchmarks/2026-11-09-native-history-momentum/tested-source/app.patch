+fn tab_frame(cx: &mut VisualTestContext, delay_ms: u64) {
+    cx.executor().advance_clock(Duration::from_millis(delay_ms));
+    cx.update(|window, app| {
+        window.simulate_next_frame(app);
+        window.refresh();
+        let _ = window.draw(app);
+    });
+    cx.run_until_parked();
+}
