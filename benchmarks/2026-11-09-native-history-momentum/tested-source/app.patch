+#[gpui::test]
+fn tab_bar_keeps_add_control_and_viewport_fixed_and_reveal_clears_bounce(cx: &mut TestAppContext) {
+    crate::ui_runtime::with_override(crate::ui_runtime::UiRuntime::live(), || {
+        let (view, cx) = cx.add_window_view(|window, _| {
+            window.activate();
+            TabSurface {
