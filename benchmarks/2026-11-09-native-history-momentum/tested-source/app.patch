+/// Programmatic replay. Optional metadata exercises native routing without
+/// manufacturing an NSEvent or claiming this was hardware input.
+#[derive(Debug, Deserialize)]
+struct ScrollPacket {
+    at_us: u64,
+    delta_px: f32,
+    #[serde(default)]
+    native: Option<ReplayPacket>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ReplayPacket {
+    source: ReplayPacketSource,
+    phase: ReplayPacketPhase,
+    age_us: u64,
+    #[serde(default)]
+    momentum_ended: bool,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum ReplayPacketSource {
+    Touch,
+    Momentum,
+    Wheel,
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum ReplayPacketPhase {
+    Started,
+    Moved,
+    Ended,
+    Cancelled,
+}
+
+impl ReplayPacket {
+    fn input(&self, scheduled: Instant) -> Option<gitcomet_ui_kit::elastic_scroll::ReplayInput> {
+        use gitcomet_ui_kit::elastic_scroll::{ReplayInput, ReplaySource};
+        Some(ReplayInput {
+            source: match self.source {
+                ReplayPacketSource::Touch => ReplaySource::Touch,
+                ReplayPacketSource::Momentum => ReplaySource::Momentum,
+                ReplayPacketSource::Wheel => ReplaySource::Wheel,
+            },
+            phase: self.phase(),
+            at: scheduled.checked_sub(Duration::from_micros(self.age_us))?,
+            momentum_ended: self.momentum_ended,
+        })
+    }
+
+    fn phase(&self) -> TouchPhase {
+        match self.phase {
+            ReplayPacketPhase::Started => TouchPhase::Started,
+            ReplayPacketPhase::Moved => TouchPhase::Moved,
+            ReplayPacketPhase::Ended => TouchPhase::Ended,
+            ReplayPacketPhase::Cancelled => TouchPhase::Cancelled,
+        }
+    }
+}
