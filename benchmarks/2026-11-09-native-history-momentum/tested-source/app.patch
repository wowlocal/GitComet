+        let context = SafePushAfterCommitContext {
+            amend: false,
+            local_branch: Some("main".into()),
+            pre_head: None,
+            post_head: None,
+        };
+        reduce(
+            &mut repos,
+            &ids,
+            &mut state,
+            Msg::SafePushAfterCommit {
+                repo_id: id,
+                context: context.clone(),
+            },
