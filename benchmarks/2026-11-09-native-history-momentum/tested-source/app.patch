+fn elastic_sidebar_keeps_interior_headers_with_short_and_empty_sections(
+    cx: &mut gpui::TestAppContext,
+) {
+    fn draw(cx: &mut gpui::VisualTestContext) {
+        cx.update(|window, app| {
