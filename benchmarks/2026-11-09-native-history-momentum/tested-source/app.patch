+    });
+    settle(cx);
+    crate::ui_runtime::with_override(crate::ui_runtime::UiRuntime::live(), || {
+        cx.update(|window, _| {
+            window.activate();
+            window.refresh();
+        });
+        elastic_draw(cx);
+        let field = cx.debug_bounds("scrollable_text_input_field").unwrap();
+        let before = cx.update(|window, app| {
+            input.update(app, |input, cx| {
