+fn the_latest_tab_reveal_supersedes_an_unmeasured_new_tab_before_paint(cx: &mut TestAppContext) {
+    crate::ui_runtime::with_override(crate::ui_runtime::UiRuntime::live(), || {
+        let (view, cx) = cx.add_window_view(|window, _| {
+            window.activate();
+            TabSurface {
