+/// Pinned rows keep their viewport anchors while the list stretches. Interior
+/// headers and branches follow the content so sections stay together, until
+/// they reach an anchor.
+pub(super) fn elastic_row_y(
+    row: usize,
+    rank: usize,
+    count: usize,
+    scroll: f32,
+    height: f32,
+    row_height: f32,
+    displacement: f32,
+) -> f32 {
+    let natural = row as f32 * row_height - scroll;
+    let top = rank as f32 * row_height;
+    let bottom = height - (count - rank) as f32 * row_height;
+    if natural <= top || natural >= bottom {
+        natural.clamp(top, bottom)
+    } else {
+        (natural + displacement).clamp(top, bottom)
+    }
+}
