+fn validate_scroll_packets(packets: &[ScrollPacket]) -> Result<(), String> {
+    if packets.is_empty()
+        || packets.len() > 10_000
+        || packets[0].at_us != 0
+        || packets.iter().any(|p| {
+            p.at_us > 60_000_000
+                || !p.delta_px.is_finite()
