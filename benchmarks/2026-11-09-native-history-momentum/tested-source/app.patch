+                let ime = input.bounds_for_range(0..0, bounds, window, cx).unwrap();
+                let thumb = window
+                    .painted_quads()
+                    .into_iter()
+                    .find(|quad| {
+                        quad.background == input.style.menu_theme.colors.scrollbar.thumb.into()
+                    })
+                    .expect("an overflowing field paints its scrollbar")
+                    .bounds;
