+/// Programmatic replay of captured deltas, without claiming native event metadata.
+#[derive(Debug, Deserialize)]
+struct ScrollPacket {
+    at_us: u64,
+    delta_px: f32,
+}
+
+fn validate_scroll_packets(packets: &[ScrollPacket]) -> Result<(), String> {
+    if packets.is_empty()
+        || packets.len() > 10_000
+        || packets[0].at_us != 0
+        || packets
+            .iter()
+            .any(|p| p.at_us > 60_000_000 || !p.delta_px.is_finite())
+        || packets.windows(2).any(|pair| pair[1].at_us < pair[0].at_us)
+    {
+        return Err("scroll packet plan must start at zero, be finite and ordered, and fit 10,000 packets/60 seconds".into());
+    }
+    Ok(())
+}
+
 fn default_true() -> bool {
     true
 }
